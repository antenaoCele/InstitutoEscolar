@url = http://localhost:3000

###
# @name login
POST {{url}}/auth/login
Content-Type: application/json

{
    "username": "rama123",
    "password": "Rama123."
}

###
@token = {{login.response.body.token}}  


###
GET {{url}}/students
Authorization: Bearer {{token}}


###
GET {{url}}/students/1
Authorization: Bearer {{token}}


###
POST {{url}}/students
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "first_name": "Celeste",
  "last_name": "Fernández",
  "dni": "8380249", 
  "school": "CPUGSM", 
  "birth_date": "2004-01-13",
  "enrolled": true,
  "level": "universitario", 
  "grade": 7
}

###
PUT {{url}}/students/12
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "first_name": "Laura",
  "last_name": "Fernández",
  "dni": 49681322,
  "school": "CPUGSM",
  "birth_date": "2004-01-13",
  "enrolled": true,
