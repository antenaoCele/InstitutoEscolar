@url=http://localhost:3000

###
# @name login
POST {{url}}/auth/login
Content-Type: application/json

{
    "username": "rama123",
    "password": "Rama123."
}

###
@token = {{login.response.body.token}}  




### Consultar usuarios
GET {{url}}/users
Authorization: Bearer {{token}}

### Consultar por un usuario
GET {{url}}/users/1
Authorization: Bearer {{token}}


### Crear usuario
POST {{url}}/users
Content-Type: application/json

{
    "first_name": "ramiro",
    "last_name": "pioli", 
    "username": "Rama123", 
    "password": "Rama123."
}

### Eliminar usuario 
DELETE {{url}}/users/1
Authorization: Bearer {{token}}

### Modificar usuario 
PUT {{url}}/users/3
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre": "Celeste",
    "apellido": "Antenao", 
    "username": "cele123", 
    "password": "Ab123456@"
}


