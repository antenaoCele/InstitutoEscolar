@url=http://localhost:3000

###
# @name login
POST {{url}}/auth/login
Content-Type: application/json

{
    "username": "juan123",
    "password": "Juan123@"
}

###
@token = {{login.response.body.token}}


### SCHEDULES

### Obtener todos los horarios
GET {{url}}/schedules
Authorization: Bearer {{token}}


### Obtener un horario por ID
GET {{url}}/schedules/3
Authorization: Bearer {{token}}


### Crear un horario
POST {{url}}/schedules
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "teacher_id": 21,
    "start_time": "10:00",
    "end_time": "10:00",
    "days": "Miércoles y jueves"
}


### Modificar un horario
PUT {{url}}/schedules/3
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "teacher_id": 1,
    "start_time": "10:00",
    "end_time": "12:00",
    "days": "Martes, Jueves"
}


### Eliminar un horario
DELETE {{url}}/schedules/1
Authorization: Bearer {{token}}
