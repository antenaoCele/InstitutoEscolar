@url = http://localhost:3000

###
# @name login
POST {{url}}/auth/login
Content-Type: application/json

{
    "username": "rama123",
    "password": "Rama123."
}

###
@token = {{login.response.body.token}}

### Obtener la lista de estudiantes y sus tutores asignados
GET {{url}}/students_tutors
Authorization: Bearer {{token}}

### Asignar un tutor a un estudiante
POST {{url}}/students_tutors
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "student_id": 1,
  "tutor_id": 1
}
